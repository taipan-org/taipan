def v(label: str, n: int) -> int:
    print("eval", label)
    return n

print(1 < 2 < 3, 3 > 2 > 2, 1 == 1 != 2, 1 <= 1 < 2 <= 2, 5 > 3 >= 3 == 3)
print(v("a", 1) < v("b", 2) < v("c", 3))
print(v("a", 3) < v("b", 2) < v("c", 3))
print(v("a", 1) < v("b", 2) > v("c", 3) < v("d", 4))
let x = 5
print(0 < x < 10, 0 < x < 5, 1 < x + 1 <= 6)
print(1 < 2.5 < 3, 0.5 < 1 < 1.5, "a" < "b" < "c", (1, 2) < (1, 3) < (2, 0))
print(not 1 < 2 < 3, (1 < 2) == (2 < 3))
let f: Callable[[int], bool] = lambda n: 0 <= n < 3
print([n for n in range(5) if 1 <= n <= 3], f(2), f(3))
var lo = 1
var hi = 3
while lo < 2 < hi:
    lo += 1
print(lo)
def deep(a: int, b: int, c: int, d: int) -> bool:
    return a < b < c < d

print(deep(1, 2, 3, 4), deep(1, 3, 2, 4))
