let rate: float = 2
var retries = 3
var total = 0
let names = ["a", "b"]
let greeting = f"hi {rate}"

for step in range(2):
    total += step

def report(a: float = rate, b: int = retries) -> float:
    return a * b

def summary(a: int = total, b: list[str] = names, c: str = greeting) -> int:
    return a + len(b) + len(c)
